<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Resume Tailoring Tool — Soma Chakraborty</title>
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; background: #f5f5f3; color: #1a1a1a; min-height: 100vh; padding: 2rem 1rem; }
  .wrapper { max-width: 800px; margin: 0 auto; }
  h1 { font-size: 22px; font-weight: 600; margin-bottom: 4px; }
  .subtitle { font-size: 13px; color: #666; margin-bottom: 1.5rem; }
  .card { background: #fff; border: 1px solid #e5e5e5; border-radius: 12px; padding: 1.25rem; margin-bottom: 1rem; }
  label { font-size: 13px; font-weight: 500; color: #555; display: block; margin-bottom: 6px; }
  textarea { width: 100%; min-height: 180px; font-size: 13px; font-family: inherit; border: 1px solid #ddd; border-radius: 8px; padding: 10px 12px; resize: vertical; outline: none; color: #1a1a1a; background: #fafafa; }
  textarea:focus { border-color: #999; background: #fff; }
  .btn { background: #1a1a1a; color: #fff; border: none; border-radius: 8px; padding: 11px 20px; font-size: 14px; font-weight: 500; cursor: pointer; width: 100%; margin-top: 10px; }
  .btn:hover { background: #333; }
  .btn:disabled { opacity: 0.4; cursor: not-allowed; }
  .btn-copy { background: #f0f0f0; border: 1px solid #ddd; border-radius: 6px; padding: 6px 14px; font-size: 12px; font-weight: 500; color: #333; cursor: pointer; white-space: nowrap; }
  .btn-copy:hover { background: #e5e5e5; }
  .btn-copy.copied { background: #e6f4d7; border-color: #b7dfa0; color: #2d6a0a; }
  .section-title { font-size: 14px; font-weight: 600; margin-bottom: 10px; }
  .output-block { background: #f8f8f8; border-radius: 8px; padding: 12px; font-size: 12px; font-family: 'Courier New', monospace; white-space: pre-wrap; word-break: break-word; line-height: 1.65; max-height: 240px; overflow-y: auto; color: #1a1a1a; border: 1px solid #eee; }
  .output-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; gap: 8px; }
  .output-hint { font-size: 12px; color: #888; }
  .score-big { font-size: 36px; font-weight: 700; }
  .badge { font-size: 11px; padding: 3px 10px; border-radius: 99px; font-weight: 600; display: inline-block; margin-left: 10px; vertical-align: middle; }
  .badge-green { background: #e6f4d7; color: #2d6a0a; }
  .badge-amber { background: #fef3c7; color: #7a4e00; }
  .badge-red { background: #fee2e2; color: #8b1a1a; }
  .bar-wrap { background: #eee; border-radius: 99px; height: 8px; margin: 10px 0 6px; overflow: hidden; }
  .bar { height: 8px; border-radius: 99px; transition: width 0.7s ease; }
  .score-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 12px; }
  .score-cell { background: #f8f8f8; border-radius: 8px; padding: 10px 12px; border: 1px solid #eee; }
  .score-cell-label { font-size: 11px; color: #888; margin-bottom: 3px; }
  .score-cell-val { font-size: 20px; font-weight: 600; }
  .missing-kw { font-size: 12px; color: #555; margin-top: 4px; line-height: 1.6; }
  .verdict { font-size: 12px; color: #555; margin-top: 6px; line-height: 1.5; }
  .tab-row { display: flex; gap: 6px; margin-bottom: 12px; flex-wrap: wrap; }
  .tab { background: transparent; border: 1px solid #ddd; border-radius: 6px; padding: 6px 14px; font-size: 13px; color: #666; cursor: pointer; }
  .tab.active { background: #1a1a1a; color: #fff; border-color: #1a1a1a; }
  .tab-panel { display: none; }
  .tab-panel.active { display: block; }
  #results { display: none; }
  .error { font-size: 13px; color: #8b1a1a; background: #fee2e2; border-radius: 8px; padding: 10px 12px; margin-top: 8px; display: none; line-height: 1.5; }
  .spinner { display: inline-block; width: 14px; height: 14px; border: 2px solid #fff; border-top-color: transparent; border-radius: 50%; animation: spin 0.7s linear infinite; vertical-align: -2px; margin-right: 6px; }
  @keyframes spin { to { transform: rotate(360deg); } }
  .note { font-size: 12px; color: #888; background: #f8f8f8; border-radius: 8px; padding: 8px 12px; margin-top: 8px; line-height: 1.6; }
  .gap-block { margin-bottom: 14px; }
  .gap-block:last-child { margin-bottom: 0; }
  .gap-heading { font-size: 13px; font-weight: 600; margin-bottom: 8px; }
  .gap-closeable { color: #2d6a0a; }
  .gap-skip { color: #888; }
  .gap-item { background: #f8f8f8; border: 1px solid #eee; border-radius: 8px; padding: 8px 12px; margin-bottom: 6px; }
  .gap-item:last-child { margin-bottom: 0; }
  .gap-term { font-size: 13px; font-weight: 600; color: #1a1a1a; }
  .gap-why { font-size: 12px; color: #666; margin-top: 2px; line-height: 1.5; }
  .gap-item.skip { background: #fafafa; }
  .gap-item.skip .gap-term { color: #888; }
</style>
</head>
<body>
<div class="wrapper">
  <h1>📄 Resume Tailoring Tool</h1>
  <p class="subtitle">Soma Chakraborty — PM Job Search · Paste any JD to get tailored LaTeX + ATS score</p>

  <div class="card">
    <label for="jd">Paste job description</label>
    <textarea id="jd" placeholder="Paste the full job description here..."></textarea>
    <div class="error" id="err"></div>
    <button class="btn" id="go-btn">Analyze &amp; Tailor Resume →</button>
  </div>

  <div id="results">
    <div class="card">
      <p class="section-title">ATS Score</p>
      <div id="ats-out"></div>
    </div>

    <div class="card">
      <p class="section-title">Tailored LaTeX — ready to paste into Overleaf</p>
      <div class="tab-row">
        <button class="tab active" data-tab="summary">Summary</button>
        <button class="tab" data-tab="skills">Skills</button>
        <button class="tab" data-tab="bullets">Experience Bullets</button>
        <button class="tab" data-tab="portfolio" id="portfolio-tab" style="display:none;">BriefBack Note</button>
      </div>

      <div class="tab-panel active" id="tab-summary">
        <div class="output-header">
          <span class="output-hint">Paste inside your <code>\section{Professional Summary}</code> block</span>
          <button class="btn-copy" data-id="out-summary">Copy</button>
        </div>
        <div class="output-block" id="out-summary"></div>
        <p class="note">↳ Replace only the paragraph text after <code>\vspace{3pt}\small</code> — keep all surrounding commands unchanged.</p>
      </div>

      <div class="tab-panel" id="tab-skills">
        <div class="output-header">
          <span class="output-hint">Paste inside your <code>\begin{tabularx}{\textwidth}{p{3.2cm} X}</code></span>
          <button class="btn-copy" data-id="out-skills">Copy</button>
        </div>
        <div class="output-block" id="out-skills"></div>
        <p class="note">↳ Replace all rows between <code>\begin{tabularx}</code> and <code>\end{tabularx}</code> — keep the wrapper commands.</p>
      </div>

      <div class="tab-panel" id="tab-bullets">
        <div class="output-header">
          <span class="output-hint">Paste inside <code>\resumeItemListStart ... \resumeItemListEnd</code> for SS&amp;C Apr 2022–Present</span>
          <button class="btn-copy" data-id="out-bullets">Copy</button>
        </div>
        <div class="output-block" id="out-bullets"></div>
        <p class="note">↳ These 3 bullets are <strong>replacements</strong> for your 3 least JD-relevant existing bullets — keep your other 4 bullets as-is. Don't delete all 7.</p>
      </div>

      <div class="tab-panel" id="tab-portfolio">
        <div class="output-header">
          <span class="output-hint">Append to your BriefBack bullet in Product Experience</span>
          <button class="btn-copy" data-id="out-portfolio">Copy</button>
        </div>
        <div class="output-block" id="out-portfolio"></div>
        <p class="note">↳ This anchors the new skills added to your Skills section (e.g. Market Research, Competitor Analysis) to real work you did on BriefBack — so it's defensible if asked about in an interview.</p>
      </div>
    </div>

    <div class="card">
      <p class="section-title">Skill Gaps</p>
      <div class="gap-block">
        <p class="gap-heading gap-closeable">✅ Worth closing before interview</p>
        <div id="gaps-closeable"></div>
      </div>
      <div class="gap-block">
        <p class="gap-heading gap-skip">⏭️ Safe to skip</p>
        <div id="gaps-skip"></div>
      </div>
    </div>
  </div>
</div>

<script>
const RESUME = `Soma Chakraborty | Product Platform Analyst | SS&C Technologies | Hyderabad
5+ years fintech/capital markets | QA, RPA (Blue Prism), Power BI, Business Analysis, C# .NET

SUMMARY:
QA Engineer transitioning into Product Management, with 5+ years in enterprise FinTech and capital markets platforms serving 100+ institutional clients. Experienced in translating customer feedback into detailed product requirements, user stories, and acceptance criteria and working directly with engineering teams across sprint planning, backlog management, and release validation. Hands-on exposure to APIs, SQL, and data-driven prioritization through Power BI, Jira, and Salesforce integrations. Conceptual familiarity with GenAI, LLMs, and AI-powered product design through independent product work.

SKILLS:
Product: Product Roadmap, Backlog Prioritization & Grooming, PRDs, User Stories, Acceptance Criteria, MVP Definition, Feature Prioritization, OKRs, Agile/Scrum
Data & Tools: SQL, Power BI, Jira, Confluence, Salesforce, Snowflake, Git, API Integration, Copilot
Domain: FinTech, Capital Markets, SaaS, Platform Products
Stakeholder: Stakeholder Management, Cross-functional Collaboration, Client-facing Requirement Gathering, Voice of Customer

EXPERIENCE (SS&C Apr 2022–Present):
- Scoped automation MVP, led cross-functional delivery using Blue Prism — reduced processing time from ~1 week to under 5 minutes
- Owned MVP scoping and requirements definition — user stories, acceptance criteria, prioritized backlog for 100+ institutional clients
- Led sprint execution and backlog health across DEV, QA, and business teams — every release tied to defined business outcomes
- Built Power BI dashboards integrating Jira and Salesforce — saved 10+ hours/month, live KPI visibility for leadership
- Synthesized voice-of-customer from 10+ institutional clients (hedge funds, asset managers) to drive prioritization
- Shifted quality upstream — reframed defects as product design gaps, reduced rework across 50+ releases

EXPERIENCE (SS&C May 2020–Apr 2022):
- Compressed release cycles from 2–5 days to 2–8 hours via automated validation framework
- Maintained outcome-driven backlog balancing client urgency, engineering constraints, business impact
- Identified defect patterns as upstream product design gaps — reduced rework on OMS Algo trading plugin for 100+ clients

PORTFOLIO: BriefBack — AI-Powered Meeting Intelligence Tool. Full PRD, personas, MoSCoW prioritization, competitive analysis, GTM with 3-tier pricing targeting GCC enterprise.
CERTIFICATIONS: IBM AI Product Manager, Product Discovery (Pendo), Google AI Essentials
EDUCATION: B.Tech IT, CGPA 8.9, 2020`;

// --- Exact LaTeX templates matching Soma's resume structure ---
const SUMMARY_TEMPLATE = `% INSTRUCTIONS: Replace ONLY the paragraph below inside your \\section{Professional Summary}
% Keep \\vspace{3pt} and \\small before this paragraph

[SUMMARY_TEXT]`;

const SKILLS_TEMPLATE = `% INSTRUCTIONS: Replace rows between \\begin{tabularx}{\\textwidth}{p{3.2cm} X} and \\end{tabularx}
% Keep \\vspace{4pt} between rows exactly as shown

[SKILLS_ROWS]`;

const BULLETS_TEMPLATE = `% INSTRUCTIONS: Replace top 3 \\resumeItem{} entries inside \\resumeItemListStart for SS&C Apr 2022–Present

[BULLET_ITEMS]`;

function $(id) { return document.getElementById(id); }
function showErr(msg) { const e = $('err'); e.textContent = msg; e.style.display = 'block'; }
function hideErr() { $('err').style.display = 'none'; }

// Robust copy: tries clipboard API first, falls back to textarea select
function copyText(text, btn) {
  function onSuccess() {
    btn.textContent = '✓ Copied!';
    btn.classList.add('copied');
    setTimeout(() => { btn.textContent = 'Copy'; btn.classList.remove('copied'); }, 2500);
  }
  function onFail() {
    // Fallback: create temp textarea, select, execCommand
    const ta = document.createElement('textarea');
    ta.value = text;
    ta.style.cssText = 'position:fixed;top:0;left:0;opacity:0;';
    document.body.appendChild(ta);
    ta.focus();
    ta.select();
    try {
      document.execCommand('copy');
      onSuccess();
    } catch(e) {
      btn.textContent = 'Select all & copy manually';
    }
    document.body.removeChild(ta);
  }
  if (navigator.clipboard && window.isSecureContext) {
    navigator.clipboard.writeText(text).then(onSuccess).catch(onFail);
  } else {
    onFail();
  }
}

document.querySelectorAll('.tab').forEach(t => {
  t.addEventListener('click', function() {
    document.querySelectorAll('.tab').forEach(x => x.classList.remove('active'));
    document.querySelectorAll('.tab-panel').forEach(x => x.classList.remove('active'));
    this.classList.add('active');
    $('tab-' + this.dataset.tab).classList.add('active');
  });
});

document.querySelectorAll('.btn-copy').forEach(b => {
  b.addEventListener('click', function() {
    const text = $(this.dataset.id).textContent;
    copyText(text, this);
  });
});

$('go-btn').addEventListener('click', async function() {
  const jd = $('jd').value.trim();
  if (!jd) { showErr('Please paste a job description first.'); return; }
  hideErr();

  const btn = this;
  btn.disabled = true;
  btn.innerHTML = '<span class="spinner"></span>Analyzing...';
  $('results').style.display = 'none';

  const prompt = `You are a LaTeX resume specialist helping Soma Chakraborty tailor her resume for PM roles.

SOMA'S RESUME DATA:
${RESUME}

JOB DESCRIPTION:
${jd}

CORE GOAL: The output must pass a 6-second recruiter scan. That means it must visually and linguistically mirror the JD's own vocabulary wherever truthfully possible — if the JD says "roadmap planning," use "roadmap planning," not a synonym like "feature planning."

OUTPUT RULES — follow exactly:

1. Respond ONLY with a valid JSON object. No markdown fences. No text before or after.

2. "summary": The paragraph text ONLY (no LaTeX wrappers). 4 lines (roughly 65-75 words total) — a strong, confident summary that reads as a direct match for this JD. Open with the role title/identity the JD is hiring for (e.g. if JD wants a "Product Manager", lead with that framing, not "QA Engineer transitioning"). Mirror the JD's exact terminology for domain, top responsibilities, and required tools/methodologies. Write in third person, no "I". Punchy, zero filler words (avoid "passionate", "dynamic", "results-driven"). No period on the last line.

3. FIRST, determine "gaps" (see rule 6 below) — then use the "closeable" gap terms as additional candidates for the "skills" section in rule 4. A closeable gap (e.g. "Market Research", "Competitor Analysis", "Product Lifecycle") should appear in Skills if Soma can defend it via BriefBack or her IBM AI PM cert — these are real, demonstrable skills, just previously unlabeled.

4. "skills": Exactly 4 rows in this format (use double backslash for newline, [4pt] spacing). Include skills/tools/methodologies explicitly mentioned in the JD (or direct synonyms) THAT SOMA CAN DEFEND — either from her current resume OR from the "closeable" gaps list (rule 6) via BriefBack/certs. DROP any of Soma's current skills the JD does not ask for, and DROP any "skip" gap (things she cannot defend), even if the JD asks for it:
\\textbf{Product} & [defensible product/PM skills in JD's wording, including closeable items like Market Research, Competitor Analysis, Product Lifecycle if applicable] \\\\[4pt]
\\textbf{Data \\& Tools} & [only tools the JD explicitly names AND Soma can defend] \\\\[4pt]
\\textbf{Domain} & [only domain terms the JD uses] \\\\[4pt]
\\textbf{Stakeholder} & [only soft skills/competencies the JD explicitly lists, in JD's exact wording]
(No trailing \\\\ on last row. Use \\& for ampersand inside textbf. Each row's content under 12 words. If a row would otherwise be empty because the JD doesn't cover that category, fill it with Soma's closest real skill in that category instead of leaving it blank.)

5. "bullets": Exactly 3 REPLACEMENT items meant to swap in for 3 of Soma's existing 7 bullets in the Apr 2022–Present role (the rest of her bullets stay as-is). EACH MUST:
- Start with a strong past-tense action verb (Led, Built, Drove, Owned, Launched, Delivered, Scoped, Reduced, Synthesized, Shipped — pick verbs that also appear in or echo the JD's responsibility verbs)
- Be STRICTLY 1-2 lines max (roughly 15-22 words total per bullet). No run-on sentences, no multiple clauses joined by multiple dashes.
- Include one concrete metric/outcome where it exists in Soma's real data (don't invent new numbers)
- Use JD vocabulary for the skill/activity being demonstrated
- Cover the 3 most JD-relevant aspects of Soma's real work, prioritized by JD weighting

Format:
\\resumeItem{\\textbf{[Action verb + short phrase]} --- [brief outcome, 1-2 lines total].}
\\resumeItem{\\textbf{[Action verb + short phrase]} --- [brief outcome, 1-2 lines total].}
\\resumeItem{\\textbf{[Action verb + short phrase]} --- [brief outcome, 1-2 lines total].}
(Use --- as separator. Each on its own line. No extra blank lines.)

6. "ats": { "overall_score": int, "keyword_match": int, "relevance": int, "experience_fit": int, "missing_keywords": ["kw1","kw2","kw3"], "verdict": "one honest sentence" }

7. "gaps": Classify every JD requirement Soma's resume doesn't cover into two lists:
   - "closeable": JD requirements/keywords that Soma can realistically prepare for or already has adjacent experience in (via SS&C work, BriefBack portfolio, IBM AI PM cert, Pendo cert, or general PM concepts) — things she could speak to in an interview with light prep (a weekend of reading, mapping existing experience to the term, etc.). For each, give: {"term": "...", "why": "one short phrase on how she can realistically address this — either by reframing existing work or quick prep", "added_to_skills": true/false (true if this term was included in the "skills" output above)}
   - "skip": JD requirements/keywords that are hands-on tool/technical skills with no realistic crash-course path (e.g. Figma, wireframing tools, specific programming languages/frameworks she's never touched, design tools) — things to simply not claim and not worry about. For each, give: {"term": "...", "why": "one short phrase on why this isn't worth pursuing for this application"}
   Keep each list to max 5 items, only the most relevant gaps for this JD.

8. "portfolio_note": A single short LaTeX sentence (10-18 words) to APPEND to the existing BriefBack bullet in Product Experience, anchoring any closeable skills (from rule 7) that were added to the Skills section — e.g. mentioning "competitive analysis" or "market research" was done as part of BriefBack. Start with a connector like "Conducted" or "Included" — do not repeat the existing bullet's content. If no closeable skills were added to Skills, return an empty string.

JSON structure:
{"ats":{...},"summary":"...","skills":"...","bullets":"...","gaps":{"closeable":[...],"skip":[...]},"portfolio_note":"..."}`;

  try {
    const res = await fetch('https://api.anthropic.com/v1/messages', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        model: 'claude-sonnet-4-6',
        max_tokens: 1000,
        messages: [{ role: 'user', content: prompt }]
      })
    });

    if (!res.ok) {
      const e = await res.json().catch(() => ({}));
      throw new Error(e?.error?.message || 'API error ' + res.status);
    }

    const data = await res.json();
    const raw = (data.content || []).filter(b => b.type === 'text').map(b => b.text).join('').trim();

    let parsed;
    try { parsed = JSON.parse(raw); }
    catch {
      const m = raw.match(/\{[\s\S]*\}/);
      if (m) parsed = JSON.parse(m[0]);
      else throw new Error('Could not parse response. Please try again.');
    }

    // Render ATS
    const a = parsed.ats;
    const score = a.overall_score;
    const color = score >= 75 ? '#2d7a0a' : score >= 55 ? '#b45309' : '#c0392b';
    const bCls = score >= 75 ? 'badge-green' : score >= 55 ? 'badge-amber' : 'badge-red';
    const bTxt = score >= 75 ? 'Strong fit' : score >= 55 ? 'Moderate fit' : 'Weak fit';
    $('ats-out').innerHTML = `
      <div style="margin-bottom:8px;">
        <span class="score-big" style="color:${color};">${score}</span>
        <span class="badge ${bCls}">${bTxt}</span>
      </div>
      <div class="bar-wrap"><div class="bar" style="width:${score}%;background:${color};"></div></div>
      <p class="verdict">${a.verdict}</p>
      <div class="score-grid">
        <div class="score-cell"><div class="score-cell-label">Keyword match</div><div class="score-cell-val">${a.keyword_match}%</div></div>
        <div class="score-cell"><div class="score-cell-label">Domain relevance</div><div class="score-cell-val">${a.relevance}%</div></div>
        <div class="score-cell"><div class="score-cell-label">Experience fit</div><div class="score-cell-val">${a.experience_fit}%</div></div>
        <div class="score-cell"><div class="score-cell-label">Missing keywords</div><div class="missing-kw">${(a.missing_keywords||[]).join(', ')}</div></div>
      </div>`;

    // Render LaTeX outputs
    $('out-summary').textContent = parsed.summary || '';
    $('out-skills').textContent = parsed.skills || '';
    $('out-bullets').textContent = parsed.bullets || '';

    // Render gaps
    const gaps = parsed.gaps || { closeable: [], skip: [] };
    $('gaps-closeable').innerHTML = (gaps.closeable || []).map(g =>
      `<div class="gap-item"><div class="gap-term">${g.term}${g.added_to_skills ? ' <span class="badge badge-green" style="margin-left:6px;">Added to Skills</span>' : ''}</div><div class="gap-why">${g.why}</div></div>`
    ).join('') || '<p class="gap-why">No specific gaps flagged for this JD.</p>';
    $('gaps-skip').innerHTML = (gaps.skip || []).map(g =>
      `<div class="gap-item skip"><div class="gap-term">${g.term}</div><div class="gap-why">${g.why}</div></div>`
    ).join('') || '<p class="gap-why">Nothing to skip — no major hands-on tool gaps for this JD.</p>';

    // Render portfolio note (only if non-empty)
    const portfolioNote = (parsed.portfolio_note || '').trim();
    if (portfolioNote) {
      $('out-portfolio').textContent = portfolioNote;
      $('portfolio-tab').style.display = 'inline-block';
    } else {
      $('portfolio-tab').style.display = 'none';
    }

    $('results').style.display = 'block';
    document.querySelectorAll('.tab').forEach(x => x.classList.remove('active'));
    document.querySelectorAll('.tab-panel').forEach(x => x.classList.remove('active'));
    document.querySelector('[data-tab="summary"]').classList.add('active');
    $('tab-summary').classList.add('active');
    $('results').scrollIntoView({ behavior: 'smooth', block: 'start' });

  } catch(e) {
    showErr('Error: ' + (e.message || 'Something went wrong. Please try again.'));
    console.error(e);
  } finally {
    btn.disabled = false;
    btn.innerHTML = 'Analyze &amp; Tailor Resume →';
  }
});
</script>
</body>
</html>
